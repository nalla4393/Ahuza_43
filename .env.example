PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_API_KEY=replace-with-a-long-random-owner-key

# Optional integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=Ahuza Apparel <orders@ahuzawear.com>
SUPPORT_EMAIL=info@ahuzawear.com

# Instamojo API 1.1 credentials (server-side only)
# Default is instamojo. Set manual_upi to use Ahuza Pay with owner confirmation.
PAYMENT_PROVIDER=instamojo
# Required only for manual_upi; verify that this UPI ID receives funds in your account.
UPI_VPA=
UPI_PAYEE_NAME=
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_SALT=
# Optional return URL; defaults to https://www.ahuzawear.com/
INSTAMOJO_REDIRECT_URL=https://www.ahuzawear.com/
# Optional signed payment notification; enabled when INSTAMOJO_SALT is set
INSTAMOJO_WEBHOOK_URL=https://www.ahuzawear.com/api/payments/instamojo/webhook
# Optional: key used to encrypt customers' saved UPI IDs (falls back to SESSION_SECRET). Changing it makes saved IDs unreadable.
CUSTOMER_DATA_KEY=

# Optional integrations
# Owner Studio image uploads (stored on the same persistent volume as the database by default)
# UPLOAD_DIR=/app/.data/uploads
MAX_UPLOAD_MB=10

# Automatic customer emails (AI-drafted via OPENAI_API_KEY). Use SMTP (e.g. Gmail app password) or RESEND_API_KEY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Social auto-posting (Meta Graph API: Facebook Page and Instagram professional account)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_API_KEY=replace-with-a-long-random-owner-key

# Optional integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=Ahuza Apparel <orders@ahuzawear.com>
SUPPORT_EMAIL=info@ahuzawear.com

# Default to Ahuza Pay's self-hosted UPI checkout with owner confirmation.
PAYMENT_PROVIDER=manual_upi
# Required for Ahuza Pay; verify that this UPI ID receives funds in your account.
UPI_VPA=
UPI_PAYEE_NAME=
# Optional Gmail API read-only OAuth credentials for Axis Bank credit-alert review.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional legacy credentials for reconciling existing Instamojo orders only.
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_SALT=
# Optional signed payment notification; enabled when INSTAMOJO_SALT is set
INSTAMOJO_WEBHOOK_URL=https://www.ahuzawear.com/api/payments/instamojo/webhook
# Optional: key used to encrypt customers' saved UPI IDs (falls back to SESSION_SECRET). Changing it makes saved IDs unreadable.
CUSTOMER_DATA_KEY=

# Optional integrations
# Owner Studio image uploads (stored on the same persistent volume as the database by default)
# UPLOAD_DIR=/app/.data/uploads
MAX_UPLOAD_MB=10

# Automatic customer emails (AI-drafted via OPENAI_API_KEY). Use SMTP (e.g. Gmail app password) or RESEND_API_KEY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Social auto-posting (Meta Graph API: Facebook Page and Instagram professional account)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

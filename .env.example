PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_API_KEY=replace-with-a-long-random-owner-key

# Optional PostgreSQL connection for storefront data. Import the existing JSON
# first with npm run db:import -- /path/to/ahuza-db.json. See README.
# STOREFRONT_DATABASE_URL=

# Optional integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=Ahuza Apparel <orders@ahuzawear.com>
SUPPORT_EMAIL=info@ahuzawear.com

# PayU is required for new UPI checkout. PAYU_MODE defaults to test;
# set production only after test payments and webhook verification.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test
PAYU_CALLBACK_URL=https://www.ahuzawear.com/api/payments/payu/callback
# Register this HTTPS endpoint for PayU payment webhooks in the merchant dashboard.
PAYU_WEBHOOK_URL=https://www.ahuzawear.com/api/payments/payu/webhook
# Optional dedicated encryption key for PayU credentials saved from Owner Studio (falls back to SESSION_SECRET).
PAYMENT_CONFIG_KEY=
# Optional Gmail API read-only OAuth credentials for Axis Bank credit-alert review.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TRUSTED_BANK_SENDERS=
# Optional legacy credentials for reconciling existing Instamojo orders only.
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_SALT=
# Optional signed payment notification; enabled when INSTAMOJO_SALT is set
INSTAMOJO_WEBHOOK_URL=https://www.ahuzawear.com/api/payments/instamojo/webhook
# Optional: key used to encrypt customers' saved UPI IDs (falls back to SESSION_SECRET). Changing it makes saved IDs unreadable.
CUSTOMER_DATA_KEY=

# Optional integrations
# Owner Studio image uploads (stored on the same persistent volume as the database by default)
# UPLOAD_DIR=/app/.data/uploads
MAX_UPLOAD_MB=10

# Automatic customer emails (AI-drafted via OPENAI_API_KEY). Use SMTP (e.g. Gmail app password) or RESEND_API_KEY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Social auto-posting (Meta Graph API: Facebook Page and Instagram professional account)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_API_KEY=replace-with-a-long-random-owner-key

# Optional integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=Ahuza Apparel <orders@example.com>

# Direct UPI intent (merchant VPA is public payment information, not a secret)
UPI_VPA=
UPI_MERCHANT_NAME=AHUZA Apparel

# Optional integrations
# Owner Studio image uploads (stored on the same persistent volume as the database by default)
# UPLOAD_DIR=/app/.data/uploads
MAX_UPLOAD_MB=10

# Automatic customer emails (AI-drafted via OPENAI_API_KEY). Use SMTP (e.g. Gmail app password) or RESEND_API_KEY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

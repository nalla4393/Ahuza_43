PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_API_KEY=replace-with-a-long-random-owner-key

# Optional integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=Ahuza Apparel <orders@example.com>


# Optional integrations
# Owner Studio image uploads (stored on the same persistent volume as the database by default)
# UPLOAD_DIR=/app/.data/uploads
MAX_UPLOAD_MB=10

# Automatic customer emails (AI-drafted via OPENAI_API_KEY). Use SMTP (e.g. Gmail app password) or RESEND_API_KEY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Social auto-posting (Meta Graph API: Facebook Page and Instagram professional account)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Ahuza Pay (private backend). Required for UPI checkout, which redirects to its hosted payment page.
# AHUZA_PAY_API_KEY must equal MERCHANT_API_KEY on the Ahuza Pay server (32+ chars). Server-side only.
AHUZA_PAY_BASE_URL=
AHUZA_PAY_API_KEY=

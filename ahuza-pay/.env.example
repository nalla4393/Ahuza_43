# Ahuza Pay service (ahuza-pay/server.mjs)
PORT=4100
# Public https URL of THIS service. Set the store's AHUZA_PAY_URL to the same value.
PUBLIC_URL=https://pay.example.com
# 32+ chars. Must equal AHUZA_PAY_API_KEY in the store's .env
MERCHANT_API_KEY=
# 16+ chars. Used by your bank-alert forwarder to call POST /api/bank/credit
BANK_WEBHOOK_SECRET=
UPI_VPA=yourname@bank
UPI_PAYEE_NAME=AHUZA
# Instant confirmation: the store's notify endpoint
STORE_NOTIFY_URL=https://your-store.example.com/api/payments/ahuza-pay/notify
# Where the pay page sends the customer after PAID (the store resumes and shows Payment Successful)
STORE_RETURN_URL=https://your-store.example.com/
# Use a persistent volume path in production
DATA_FILE=/data/ahuza-pay-data.json
